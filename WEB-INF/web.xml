<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">

    <!-- Music Search -->
    <servlet>
        <servlet-name>musicsearchservlet</servlet-name>
        <servlet-class>servlets.MusicSearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>musicsearchservlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>

    <!-- Auth -->
    <servlet>
        <servlet-name>authservlet</servlet-name>
        <servlet-class>servlets.AuthServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>authservlet</servlet-name>
        <url-pattern>/auth</url-pattern>
    </servlet-mapping>

    <!-- Playlists -->
    <servlet>
        <servlet-name>playlistservlet</servlet-name>
        <servlet-class>servlets.PlaylistServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>playlistservlet</servlet-name>
        <url-pattern>/playlists</url-pattern>
    </servlet-mapping>

    <!-- Device Management (multi-device remote control) -->
    <servlet>
        <servlet-name>deviceservlet</servlet-name>
        <servlet-class>servlets.DeviceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>deviceservlet</servlet-name>
        <url-pattern>/devices</url-pattern>
    </servlet-mapping>

    <!-- Player State (queue, progress, volume, EQ …) -->
    <servlet>
        <servlet-name>stateservlet</servlet-name>
        <servlet-class>servlets.StateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>stateservlet</servlet-name>
        <url-pattern>/state</url-pattern>
    </servlet-mapping>

    <!-- Stream (quality transcoding) -->
    <servlet>
        <servlet-name>streamservlet</servlet-name>
        <servlet-class>servlets.StreamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>streamservlet</servlet-name>
        <url-pattern>/stream</url-pattern>
    </servlet-mapping>

</web-app>
